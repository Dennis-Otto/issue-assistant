# The words of Markdown and of GitHub's links, for libFuzzer's mutations of the
# text that fuzz/fuzz_sanitize.py cleans; fuzz/seeds.py adds the file to its
# command line. One "word" per line, with \\, \" and \xNN as escapes.

# Code, fences, and what could split or end them.
"`"
"```"
"````"
"~~~"
"    "
"\x09"
"\\"
"\x0a"
"\x0a\x0a"

# Blocks: headings, lists, quotes and the delimiter rows of tables.
"#"
"\x0a#\x0a"
"- "
"* "
"1. "
"> "
"|"
":-:"
"--|--"

# HTML, links, images and entities.
"<"
">"
"<!--"
"-->"
"<b>"
"<<b>b>"
"["
"]"
"]("
"!["
"[x]: "
"&"
"&#64;"
"&lt;"
";"

# Mentions, references, commits and e-mail.
"@"
"@octocat"
"@org/team"
"#12"
"GH-"
"owner/repo"
"owner/repo#3"
"owner/repo@0123abc"
"user@0123abc"
"a@b.example"
"mailto:"
"xmpp:"

# Addresses, where they lead, and what GitHub leaves out at their end.
"https://"
"HTTPS://"
"http://"
"www."
"https://evil.example/"
"https://docs.example.com/"
"https://github.com/owner/project/blob/"
"https://github.com/other/repo/blob/"
"/../"
"%2e%2e"
"%2F"
"user@"
":8443"
"_"
"*"
"~"
"("
")"
"'"
"\""
"."

# Spaces that only some parsers take for one, and characters that GitHub hides.
"\xc2\xa0"
"\xe2\x80\x83"
"\xe2\x80\x8b"
"\x1d"
"\x0d"
