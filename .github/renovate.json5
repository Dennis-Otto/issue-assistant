// Renovate for this repository: the rules of the blueprint in
// .github/renovate-blueprint.json5, then those of the project alone below, which
// override them, such as a package that must wait or two that move together:
// https://docs.renovatebot.com/configuration-options/
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/issue-assistant//.github/renovate-blueprint.json5"],
  packageRules: [
    {
      // Renovate's manager for GitHub Actions reads templates/.github/workflows/
      // too, so the actions of the templates stay current. It never moves the pins
      // of the issue assistant itself: in templates/ they are placeholders that
      // install replaces with the commit hash of its release, and the copies in
      // .github/ belong to the blueprint, which installs a release and moves its
      // pins together. A pin alone would fail the check of a release that changed
      // a template (decision 0007).
      matchDepNames: ["Dennis-Otto/issue-assistant"],
      enabled: false,
    },
    {
      // The engine's action runs only in the job analyze, on the firewall runner and
      // with the engine's secret, which only main may use: no check of a pull
      // request runs it. So its updates come in a pull request of their own and wait
      // for the maintainer. The push of the merge to main starts the Canary
      // (.github/workflows/canary.yml), which runs the AI's whole path with the new
      // version; a release follows only once it passed (docs/architecture.md). The
      // check engine contracts of the pull request has checked its inputs and outputs.
      matchDepNames: ["anthropics/claude-code-action"],
      groupName: "the engine's action",
      automerge: false,
      prBodyNotes: [
        "**This update waits for you.** The engine's action runs only on `main`, where the engine's secret is, so no check of this pull request runs it; the check *engine contracts* below only shows that the action still has each input that the workflows pass and each output that they read. Merge it when you can watch the [Canary](https://github.com/Dennis-Otto/issue-assistant/actions/workflows/canary.yml): the push to `main` starts it, and it runs the analysis of a fixture issue with this version, from the engine on the firewall runner to the checked answer. Release only once it passed; if it fails, revert this update.",
      ],
    },
    {
      // The other engines run only in the job analyze too, and the Canary runs only
      // this repository's engine, Claude: no run of the AI tries their updates
      // before a release brings them to every repository that uses them. The
      // version of Codex is below a line "# renovate:" in the reusable workflows;
      // the Gemini CLI and the Copilot CLI are in the lock files of engines/, which
      // Renovate's manager of npm updates, each package with its hash, and so does
      // the weekly refresh of the lock files, which waits for the maintainer too.
      // The check engine contracts of the pull request runs them without a key:
      // the inputs and outputs of the action, the flags and the settings of the
      // command lines, the signatures of npm's registry of every package of the
      // lock files, and that npm refuses a package whose hash is not the locked one.
      matchDepNames: [
        "openai/codex-action",
        "@openai/codex",
        "@google/gemini-cli",
        "@github/copilot",
      ],
      groupName: "the other engines",
      automerge: false,
      prBodyNotes: [
        "**This update waits for you.** Codex, Gemini and Copilot run only in the job `analyze`, with their secrets, and the Canary runs Claude alone, so neither a check of this pull request nor the Canary runs these versions with a key. The check *engine contracts* below runs them without one: green, the action still has each input that the workflows pass and each output that they read, each command line lists each flag of its step in its help and takes its values, the Gemini CLI's schema has each key of its settings, and each one starts and stops only for the missing key. For the Gemini CLI and the Copilot CLI, it also installs the lock files of `engines/` as `analyze` does, verifies the signature of npm's registry and the attestations of every package in them, and checks that npm refuses a package whose hash is not the one of the lock file. A new indirect dependency in a lock file runs with the secret of the engine in every repository after the release: look at what the diff of `package-lock.json` adds. It can't see their answers or their hosts: read their release notes for those, and, if you can, run an analysis by hand in a repository that uses the engine, after the merge and before the release.",
      ],
    },
  ],
}
