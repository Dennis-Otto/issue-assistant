// Renovate for this repository: the rules of the blueprint in
// .github/renovate-blueprint.json5, then those of the project alone below, which
// override them, such as a package that must wait or two that move together:
// https://docs.renovatebot.com/configuration-options/
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/issue-assistant//.github/renovate-blueprint.json5"],
  packageRules: [
    {
      // Renovate's manager for GitHub Actions reads templates/.github/workflows/
      // too, so the actions of the templates stay current. It never moves the pins
      // of the issue assistant itself: in templates/ they are placeholders that
      // install replaces with the commit hash of its release, and the copies in
      // .github/ belong to the blueprint, which installs a release and moves its
      // pins together. A pin alone would fail the check of a release that changed
      // a template (decision 0007).
      matchDepNames: ["Dennis-Otto/issue-assistant"],
      enabled: false,
    },
    {
      // The engines are the AI: the engine's action, the Claude Code action, and the
      // other engines, Codex with its action and its command line, the Gemini CLI and
      // the Copilot CLI. Each runs only in the job analyze, with its secret, which only
      // main may use, so no check of a pull request runs one with a key. The version
      // of Codex is below a line "# renovate:" in the reusable workflows; the Gemini
      // CLI and the Copilot CLI are in the lock files of engines/, which Renovate's
      // manager of npm updates, each package with its hash. Every update of them
      // merges on its own, a minor or major version and a new commit of a tag too,
      // once every required check passed, a week after its release (decision 0030):
      // the check engine contracts runs them without a key, the Canary
      // (.github/workflows/canary.yml) runs the AI's whole path with the engine's
      // action after the merge, and the pull request of the next release waits for
      // it by its required check the Canary of main
      // (.github/workflows/release-gate.yml). The weekly refresh of the lock files
      // merges on its own as well, by the rules of the blueprint, from versions a
      // week old. Each engine comes in a pull request of its own, so an update that
      // fails its checks holds back no other engine.
      //
      // The title of each names the engine and both versions, such as "fix(deps):
      // update the Gemini CLI to 0.66.0 (was 0.65.0)": the release takes the title of
      // a pull request of Renovate as its entry of the changelog and its line of the
      // notes, since a bot writes no fragment of changelog.d/. Renovate writes
      // commitMessageExtra only into the title of a group that holds one package and
      // one version, and leaves it out of a group of several, as it did in #311, so
      // each package of an engine has a group of its own, Codex one for its action
      // and one for its command line (decision 0032). A new commit of a tag keeps its
      // version and names the commit instead. Renovate would write the title in lower
      // case, "the gemini cli"; commitMessageLowerCase keeps the names as they are,
      // and commitMessageAction the verb in lower case, as in every other title.
      matchDepNames: [
        "anthropics/claude-code-action",
        "openai/codex-action",
        "@openai/codex",
        "@google/gemini-cli",
        "@github/copilot",
      ],
      automerge: true,
      commitMessageAction: "update",
      commitMessageLowerCase: "never",
      commitMessageExtra: "to {{#if (equals updateType 'digest')}}a new commit of {{{currentValue}}}, {{{newDigestShort}}}{{else}}{{{newVersion}}} (was {{{currentVersion}}}){{/if}}",
    },
    {
      matchDepNames: ["anthropics/claude-code-action"],
      groupName: "the engine's action",
      commitMessageTopic: "the Claude Code action",
      prBodyNotes: [
        "**This update merges on its own** once every required check passed, as [decision 0030](https://github.com/Dennis-Otto/issue-assistant/blob/main/docs/decisions/0030-every-update-of-an-engine-merges-on-its-own-and-the-release-waits-for-the-canary.md) says, a minor or major version too. The engine's action runs only on `main`, where the engine's secret is, so no check of this pull request runs it; the required check *engine contracts* below shows that the action still has each input that the workflows pass and each output that they read. The push of the merge to `main` starts the [Canary](https://github.com/Dennis-Otto/issue-assistant/actions/workflows/canary.yml), which runs the analysis of a fixture issue with this version, from the engine on the firewall runner to the checked answer, and the pull request of the next release waits until a Canary of `main` passed, by its required check *the Canary of main*. If the Canary fails, revert this update; the release goes once a Canary passes again.",
      ],
    },
    {
      matchDepNames: ["openai/codex-action"],
      groupName: "the Codex action",
      commitMessageTopic: "the Codex action",
    },
    {
      matchDepNames: ["@openai/codex"],
      groupName: "the Codex CLI",
      commitMessageTopic: "the Codex CLI",
    },
    {
      matchDepNames: ["@google/gemini-cli"],
      groupName: "the Gemini CLI",
      commitMessageTopic: "the Gemini CLI",
    },
    {
      matchDepNames: ["@github/copilot"],
      groupName: "the Copilot CLI",
      commitMessageTopic: "the Copilot CLI",
    },
    {
      matchDepNames: [
        "openai/codex-action",
        "@openai/codex",
        "@google/gemini-cli",
        "@github/copilot",
      ],
      prBodyNotes: [
        "**This update merges on its own** once every required check passed, as [decision 0030](https://github.com/Dennis-Otto/issue-assistant/blob/main/docs/decisions/0030-every-update-of-an-engine-merges-on-its-own-and-the-release-waits-for-the-canary.md) says, a minor or major version too. Codex, Gemini and Copilot run only in the job `analyze`, with their secrets, and the Canary runs Claude alone, so neither a check of this pull request nor the Canary runs this version with a key. The required check *engine contracts* below runs it without one: green, the action still has each input that the workflows pass and each output that they read, each command line lists each flag of its step in its help and takes its values, the Gemini CLI's schema has each key of its settings, and each one starts and stops only for the missing key. For the Gemini CLI and the Copilot CLI, it also installs the lock files of `engines/` as `analyze` does, verifies the signature of npm's registry and the attestations of every package that npm installs from them on GitHub's Ubuntu x64 runner, where `analyze` runs, and checks that npm refuses a package whose hash is not the one of the lock file. It can't see their answers, their hosts or what a new indirect dependency of a lock file does, which the firewall keeps to the hosts of the engine: the decision names that risk. If an analysis with this engine goes wrong after the next release, revert this update.",
      ],
    },
    {
      // The command line of Claude in .github/evaluate/, which only the Evaluate
      // workflow installs, when a maintainer runs it; the job analyze gets Claude Code
      // from its action. It comes out nearly every day, and a measurement can wait, so
      // once a month is enough. No release ships it, so its commit is a chore: as
      // fix(deps), the default for dependencies, each update would publish a release
      // with nothing in it. The rules of the blueprint merge a minor or patch version;
      // a major one waits for the maintainer, since no check runs this command line.
      matchDepNames: ["@anthropic-ai/claude-code"],
      groupName: "the command line of Claude for the Evaluate workflow",
      schedule: ["* * 1 * *"],
      semanticCommitType: "chore",
    },
  ],
}
